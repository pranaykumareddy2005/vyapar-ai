# Copy to .env for local development. Never commit real secrets.

ENVIRONMENT=development
DEBUG=true

# Datastores
DB_URL=postgresql+psycopg://vyapar:vyapar@localhost:5432/vyapar
REDIS_URL=redis://localhost:6379/0

# Security (generate a strong random value for non-dev environments)
JWT_SECRET=dev-insecure-change-me
JWT_ACCESS_TTL_SECONDS=900

# Messaging: mock | whatsapp  (whatsapp is not implemented; use mock)
MESSAGING_PROVIDER=mock
WA_VERIFY_TOKEN=dev-verify-token
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=

# AI provider: mock | gemini | ollama
#   mock   - deterministic keyword engine (dev/tests only; rejected in production)
#   gemini - hosted Google Generative Language API (requires AI_API_KEY)
#   ollama - local inference via an Ollama server (no external credentials)
AI_PROVIDER=mock
AI_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.6

# Ollama (only used when AI_PROVIDER=ollama). Models are configurable per workload
# so no model name is hard-coded. Run Ollama on the host (recommended) or via the
# optional docker-compose "ollama" profile; point OLLAMA_BASE_URL at it.
#   - Docker Desktop (app in a container -> host Ollama): http://host.docker.internal:11434
#   - App on the host:                                    http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# Conversation/intent model. qwen2.5:7b = strong multilingual + strict JSON (~4.7 GB,
# fits ~6 GB VRAM). For lower latency use qwen2.5:3b-instruct or llama3.2:3b.
OLLAMA_CONVERSATION_MODEL=qwen2.5:7b
# Vision model for catalog draft generation from an image.
OLLAMA_CATALOG_MODEL=qwen2.5vl:3b
# Embedding model (reserved for future multilingual semantic product search).
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_REQUEST_TIMEOUT_SECONDS=60.0

# Payments: mock | razorpay  (razorpay requires RZP_KEY/RZP_SECRET)
PAYMENT_PROVIDER=mock
RZP_KEY=
RZP_SECRET=

# Tax: configurable rate applied to orders (0.0 = none by default)
DEFAULT_TAX_RATE=0.0

# Object storage: memory | s3
STORAGE_BACKEND=memory
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vyapar
S3_REGION=us-east-1
