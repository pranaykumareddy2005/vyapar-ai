# Copy to .env for local development. Never commit real secrets.

ENVIRONMENT=development
DEBUG=true

# Datastores
DB_URL=postgresql+psycopg://vyapar:vyapar@localhost:5432/vyapar
REDIS_URL=redis://localhost:6379/0

# Security (generate a strong random value for non-dev environments)
JWT_SECRET=dev-insecure-change-me
JWT_ACCESS_TTL_SECONDS=900

# Messaging: mock | whatsapp  (whatsapp is not implemented; use mock)
MESSAGING_PROVIDER=mock
WA_VERIFY_TOKEN=dev-verify-token
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=

# AI provider: mock | gemini  (gemini requires AI_API_KEY)
AI_PROVIDER=mock
AI_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.6

# Payments: mock | razorpay  (razorpay requires RZP_KEY/RZP_SECRET)
PAYMENT_PROVIDER=mock
RZP_KEY=
RZP_SECRET=

# Tax: configurable rate applied to orders (0.0 = none by default)
DEFAULT_TAX_RATE=0.0

# Object storage: memory | s3
STORAGE_BACKEND=memory
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vyapar
S3_REGION=us-east-1
